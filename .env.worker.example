# Worker process only. Keep the signing key out of the API environment.
NEON=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SOLANA_HTTPS_ENDPOINT=https://your-private-solana-rpc
SOLANA_WSS_ENDPOINT=wss://your-private-solana-rpc
ARTEMI_TREASURY_PUBLIC_KEY=your-treasury-public-key
# JSON array of 64 secret-key bytes; obtain through secure provisioning.
ARTEMI_TREASURY_PRIVATE_KEY=
PORT=8080
