# API and migration process only. Never commit real credentials.
NEON=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SOLANA_HTTPS_ENDPOINT=https://your-private-solana-rpc
SOLANA_WSS_ENDPOINT=wss://your-private-solana-rpc
ARTEMI_TREASURY_PUBLIC_KEY=your-treasury-public-key
PINATA_JWT=your-server-upload-token
PINATA_GATEWAY=your-gateway.mypinata.cloud
# Optional operator API; 16-byte hex salt:64-byte scrypt hash
ARTEMI_ADMIN_PASSWORD_HASH=
